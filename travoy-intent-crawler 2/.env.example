# Wajib: nilai cookie "auth_token" dari akun X Anda (lihat README).
# Jangan pernah commit file .env ke repository.
TWITTER_AUTH_TOKEN=

# Mesin crawling: playwright (default, langsung ke x.com/search) atau tweet-harvest
HARVEST_ENGINE=playwright
# false = jendela browser terlihat (berguna untuk debug)
HEADLESS=true
# true = selalu simpan screenshot, log jaringan, dan contoh respons ke folder debug/
DEBUG_DUMP=false
# chromium = headless baru (disarankan); chrome = pakai Google Chrome yang terpasang
BROWSER_CHANNEL=chromium

# Parameter pencarian
TWEET_LANG=id
SEARCH_TAB=LATEST
SINCE=2023-01-01
UNTIL=
LIMIT_PER_KEYWORD=200
EXCLUDE_RETWEETS=true

# Ritme crawling (jaga agar tidak kena rate limit)
DELAY_PER_TWEET_SEC=3
PAUSE_BETWEEN_KEYWORDS_SEC=60
KEYWORD_TIMEOUT_MIN=30
MAX_RETRY=1
RATE_LIMIT_PAUSE_MIN=15

# Privasi: username di-hash, user_id & lokasi dibuang
ANONYMIZE_USER=true
HASH_SALT=ganti-dengan-string-acak

# Lokasi hasil
OUTPUT_DIR=output

# Server file hasil (npm run serve)
SERVER_PORT=8080
# 127.0.0.1 = hanya dari laptop ini; 0.0.0.0 = bisa diakses dari jaringan (wajib isi SERVER_ACCESS_KEY)
SERVER_HOST=127.0.0.1
SERVER_ACCESS_KEY=
