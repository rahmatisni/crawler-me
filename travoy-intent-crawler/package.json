{
  "name": "travoy-intent-crawler",
  "version": "1.0.0",
  "description": "Servis crawling X (Twitter) per intent untuk korpus klasifikasi intent voice assistant Travoy, memakai tweet-harvest.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "postinstall": "node src/core/patch-tweet-harvest.js && playwright install chromium",
    "crawl:emergency_call": "node src/services/emergency_call.service.js",
    "crawl:get_traffic_info": "node src/services/get_traffic_info.service.js",
    "crawl:find_rest_area": "node src/services/find_rest_area.service.js",
    "crawl:find_gas_station": "node src/services/find_gas_station.service.js",
    "crawl:find_ev_charger": "node src/services/find_ev_charger.service.js",
    "crawl:get_toll_transactions": "node src/services/get_toll_transactions.service.js",
    "crawl:check_card_balance": "node src/services/check_card_balance.service.js",
    "crawl:check_toll_tariff": "node src/services/check_toll_tariff.service.js",
    "crawl:open_travoy_go": "node src/services/open_travoy_go.service.js",
    "crawl:play_travoy_fm": "node src/services/play_travoy_fm.service.js",
    "crawl:get_near_me": "node src/services/get_near_me.service.js",
    "crawl:all": "node src/run-all.js",
    "dry-run": "node src/run-all.js --dry-run",
    "patch": "node src/core/patch-tweet-harvest.js",
    "export": "node src/export.js",
    "serve": "node src/server.js",
    "setup": "bash scripts/setup.sh"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "papaparse": "^5.4.1",
    "tweet-harvest": "2.7.1",
    "playwright": "1.64.1",
    "exceljs": "4.4.0",
    "archiver": "7.0.1"
  },
  "overrides": {
    "@playwright/test": "1.64.1",
    "playwright": "1.64.1",
    "playwright-core": "1.64.1"
  }
}
